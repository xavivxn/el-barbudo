generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Product {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  subtitle    String
  category    String
  description String
  notes       String?
  benefits    String    @default("[]")
  tags        String    @default("[]")
  images      String    @default("[]")
  featured    Boolean   @default(false)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  variants    Variant[]
}

model Variant {
  id        String  @id @default(cuid())
  productId String
  label     String
  price     Int
  stock     Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Service {
  id          String @id @default(cuid())
  name        String
  description String
  price       Int
  order       Int    @default(0)
}

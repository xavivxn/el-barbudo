# Modo demo: la tienda real necesita DEMO_MODE="false". Sin esta variable (como en un deploy de
# Vercel sin configurar) el sitio corre como demo: catálogo de ejemplo, sin base y con el admin apagado.
DEMO_MODE="false"

# Base de datos (SQLite local)
DATABASE_URL="file:./dev.db"

# Contraseña del panel de administración
ADMIN_PASSWORD="cambiar-esta-contrasena"

# Secreto de sesión: al menos 32 caracteres
SESSION_SECRET="cambiar-por-un-secreto-de-al-menos-32-caracteres"

# Número de WhatsApp del local, solo dígitos con código de país (ej. 5959XXXXXXXX).
# El de abajo es un marcador que no es de nadie: el build de producción falla si queda así.
NEXT_PUBLIC_WHATSAPP_NUMBER="595000000000"
